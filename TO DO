
import React, {useState} from 'react';
import {
  View, Text, TextInput, TouchableOpacity,
  FlatList, StyleSheet
} from 'react-native';

export default function App() {

  const [task, setTask] = useState('');
  const [tasks, setTasks] = useState([]);

  const add = () => {
    if (!task.trim()) return;

    setTasks([...tasks, {
      id: Date.now().toString(),
      text: task,
      completed: false
    }]);

    setTask('');
  };

  const toggle = (id) => {
    setTasks(tasks.map(t =>
      t.id === id ? {...t, completed: !t.completed} : t
    ));
  };

  const del = (id) => {
    setTasks(tasks.filter(t => t.id !== id));
  };

  const stats = [
    {n: tasks.length, l: 'Total'},
    {n: tasks.filter(t => t.completed).length, l: 'Done'}
  ];

  return (
    <View style={s.container}>

      <View style={s.header}>
        <Text style={s.title}>✨ My Tasks</Text>
        <Text style={s.subtitle}>Stay organized every day</Text>
      </View>

      <View style={s.statsContainer}>
        {stats.map((x, i) => (
          <View key={i} style={s.statCard}>
            <Text style={s.statNumber}>{x.n}</Text>
            <Text style={s.statText}>{x.l}</Text>
          </View>
        ))}
      </View>

      <View style={s.inputContainer}>
        <TextInput
          placeholder="Add a new task..."
          value={task}
          onChangeText={setTask}
          style={s.input}
        />

        <TouchableOpacity style={s.addButton} onPress={add}>
          <Text style={s.addButtonText}>Add</Text>
        </TouchableOpacity>
      </View>

      {tasks.length > 0 ? (
        <FlatList
          data={tasks}
          keyExtractor={item => item.id}
          renderItem={({item}) => (
            <View style={s.taskCard}>

              <TouchableOpacity
                style={s.taskContent}
                onPress={() => toggle(item.id)}
              >
                <Text style={s.check}>
                  {item.completed ? '✅' : '⬜'}
                </Text>

                <Text style={[
                  s.taskText,
                  item.completed && s.completed
                ]}>
                  {item.text}
                </Text>
              </TouchableOpacity>

              <TouchableOpacity onPress={() => del(item.id)}>
                <Text style={s.delete}>🗑️</Text>
              </TouchableOpacity>

            </View>
          )}
        />
      ) : (
        <View style={s.empty}>
          <Text style={s.emptyText}>📝 No tasks yet</Text>
          <Text style={s.emptySub}>Add your first task above</Text>
        </View>
      )}

    </View>
  );
}

